{
    "name": "minhyung/trif-fxrt",
    "description": "PHP library for Exchange rates API of Korea Customs Service",
    "type": "library",
    "keywords": ["fxrt", "exchange rates"],
    "license": "MIT",
    "authors": [
        {
            "name": "Minhyung Park",
            "email": "urlinee@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/overworks/php-trif-fxrt/issues",
        "source": "https://github.com/overworks/php-trif-fxrt"
    },
    "require": {
        "php": "^8.1",
        "ext-xml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Minhyung\\TrifFxrt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Minhyung\\TrifFxrt\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
